{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jurisconecta-mvp",
  "account_id": "4ea4b93b4874da271a0116bd4728f282",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "jurisconecta.cl",
      "custom_domain": true
    },
    {
      "pattern": "www.jurisconecta.cl",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jurisconecta-db",
      "database_id": "106131c9-81eb-49de-9418-421ccc172576"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LAWYER_DOCUMENTS",
      "bucket_name": "jurisconecta-private-documents"
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
